{
  "info": {
    "_postman_id": "f97e9727-9d1e-4bfa-957a-5918351afa65",
    "name": "El Garage - API",
    "description": "Collection de test pour l'API El Garage (NestJS + Prisma). Suivre l'ordre des dossiers : Auth -> Customers -> Vehicles -> Work Orders -> Diagnosis -> Tasks. Chaque requete qui cree une ressource sauvegarde son id dans une variable d'environnement (customerId, vehicleId, workOrderId...) utilisee par les requetes suivantes.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Auth",
      "description": "",
      "item": [
        {
          "name": "Register garage (Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/garages/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "garages",
                "register"
              ]
            },
            "description": "Cree le Garage (status PENDING_APPROVAL) + l'Admin en une seule requete. Ne renvoie PAS de token -- il faut se logger ensuite.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"garageName\": \"Speedy Auto\",\n  \"garagePhone\": \"20123456\",\n  \"garageAddress\": \"12 Avenue Habib Bourguiba, Tunis\",\n  \"adminName\": \"Bechir Marweni\",\n  \"adminEmail\": \"admin@speedy-auto.tn\",\n  \"adminPassword\": \"MotDePasse123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": []
        },
        {
          "name": "Login (Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Le login reussit meme si garageStatus = PENDING_APPROVAL (le backend ne bloque pas l'API, seul le futur frontend afficherait un ecran d'attente).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@speedy-auto.tn\",\n  \"password\": \"MotDePasse123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.accessToken) {",
                  "    pm.environment.set('token', data.accessToken);",
                  "    pm.environment.set('garageId', data.user.garageId);",
                  "    console.log('Token sauvegarde dans {{token}}');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Me (verification du token)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            },
            "description": "Doit renvoyer id/garageId/role si le token Bearer est valide -- confirme que toute la chaine JwtStrategy -> JwtAuthGuard fonctionne.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": []
        }
      ]
    },
