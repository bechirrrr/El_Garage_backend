# Base de donnees PostgreSQL
# Format : postgresql://UTILISATEUR:MOTDEPASSE@HOTE:PORT/NOM_BASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/el_garage?schema=public"

# Port de l'API NestJS
PORT=3000

# Secret pour signer les JWT (a remplacer par une vraie valeur aleatoire)
JWT_SECRET="change-me-en-une-chaine-aleatoire-longue"
JWT_EXPIRES_IN="7d"

# Envoi d'email (invitations Mecanicien/Front Desk, Section 4/29).
# Optionnel en dev : si SMTP_HOST est absent, MailService affiche les
# emails dans la console au lieu de les envoyer -- rien n'est bloque.
#
# Options simples pour commencer :
#   - Mailtrap (recommande pour le dev) : boite de reception factice,
#     gratuite, aucun email reel envoye -> mailtrap.io
#   - Gmail : smtp.gmail.com, port 587, necessite un "mot de passe
#     d'application" (pas ton mot de passe Gmail normal)
#   - Brevo / Resend : gratuits, utilisables en production plus tard
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="no-reply@el-garage.local"

# URL du frontend Angular, utilisee pour construire le lien dans l'email
# d'invitation (ex: http://localhost:4200/invitations/<token>).
FRONTEND_URL="http://localhost:4200"
